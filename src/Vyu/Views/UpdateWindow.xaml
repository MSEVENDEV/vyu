<Window x:Class="Vyu.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vyu update" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Width="600" SizeToContent="Height" WindowStartupLocation="CenterOwner" ShowInTaskbar="True" Icon="/Assets/vyu.ico">
    <Grid x:Name="Root" Margin="24">
        <Border CornerRadius="24" Background="{StaticResource K.Bg1Brush}" BorderBrush="{StaticResource K.Line2Brush}" BorderThickness="1" MouseLeftButtonDown="OnDrag">
            <Border.Effect>
                <DropShadowEffect BlurRadius="42" ShadowDepth="0" Opacity="0.6" Color="Black" />
            </Border.Effect>
            <Grid>
                <Border CornerRadius="24" Background="{StaticResource K.Aurora}" IsHitTestVisible="False" />
                <StackPanel Margin="28,26,28,24">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/vyu-mark.png" Width="54" Height="54" RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="UPDATE AVAILABLE" Style="{StaticResource K.Overline}" Foreground="{StaticResource K.Accent1Brush}" />
                                <TextBlock x:Name="TitleText" Style="{StaticResource K.H2}" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <Button Style="{StaticResource K.Button.IconGhost}" Content="&#xE711;" FontSize="11" Width="32" Height="32"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnLater" ToolTip="Later" />
                    </Grid>
                    <TextBlock x:Name="SubText" Style="{StaticResource K.Caption}" Margin="0,14,0,0" TextWrapping="Wrap" />

                    <Border Background="{StaticResource K.Bg2Brush}" BorderBrush="{StaticResource K.LineBrush}" BorderThickness="1" CornerRadius="14" Padding="16,12" Margin="0,12,0,0">
                        <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="NotesText" Style="{StaticResource K.Text}" FontSize="13" TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource K.Text2Brush}" />
                        </ScrollViewer>
                    </Border>

                    <!-- schedule choices -->
                    <Grid x:Name="SchedulePanel" Margin="0,14,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource K.Button}" Height="Auto" Padding="14,12" HorizontalContentAlignment="Left" Click="OnScheduleExit">
                            <StackPanel>
                                <TextBlock x:Name="OnExitTitle" Text="When I close Vyu" FontWeight="SemiBold" />
                                <TextBlock Text="Installs quietly as it closes" Style="{StaticResource K.Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TonightBtn" Grid.Column="2" Style="{StaticResource K.Button}" Height="Auto" Padding="14,12" HorizontalContentAlignment="Left" Click="OnScheduleTonight">
                            <StackPanel>
                                <TextBlock Text="Tonight at 3:00 AM" FontWeight="SemiBold" />
                                <TextBlock Text="If Vyu is open — never during a video" Style="{StaticResource K.Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel x:Name="ProgressPanel" Margin="0,16,0,0" Visibility="Collapsed">
                        <ProgressBar x:Name="Bar" Style="{StaticResource K.Progress}" Height="6" Maximum="1" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource K.Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Margin="0,20,0,0">
                        <Button x:Name="LaterBtn" Style="{StaticResource K.Button.Ghost}" Content="Later" HorizontalAlignment="Left" Height="42" Padding="18,0" Click="OnLater" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ScheduleBtn" Style="{StaticResource K.Button}" Height="42" Padding="18,0" Click="OnSchedule">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE787;" Style="{StaticResource K.Icon}" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="Schedule" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NowBtn" Style="{StaticResource K.Button.Primary}" Height="42" Padding="20,0" Margin="10,0,0,0" Click="OnNow">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE777;" Style="{StaticResource K.Icon}" FontSize="14" VerticalAlignment="Center" Foreground="White" />
                                    <TextBlock x:Name="NowText" Text="Update now &amp; restart" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
