<!-- KINETIC DESIGN SYSTEM · controls (WPF) -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================== text ============================== -->
    <Style x:Key="K.Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource K.Font}" />
        <Setter Property="FontSize" Value="{StaticResource K.Size.Body}" />
        <Setter Property="Foreground" Value="{StaticResource K.Text1Brush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>
    <Style x:Key="K.Display" TargetType="TextBlock" BasedOn="{StaticResource K.Text}">
        <Setter Property="FontFamily" Value="{StaticResource K.FontDisplay}" />
        <Setter Property="FontSize" Value="{StaticResource K.Size.Display}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>
    <Style x:Key="K.H1" TargetType="TextBlock" BasedOn="{StaticResource K.Text}">
        <Setter Property="FontFamily" Value="{StaticResource K.FontDisplay}" />
        <Setter Property="FontSize" Value="{StaticResource K.Size.H1}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>
    <Style x:Key="K.H2" TargetType="TextBlock" BasedOn="{StaticResource K.Text}">
        <Setter Property="FontFamily" Value="{StaticResource K.FontDisplay}" />
        <Setter Property="FontSize" Value="{StaticResource K.Size.H2}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="K.H3" TargetType="TextBlock" BasedOn="{StaticResource K.Text}">
        <Setter Property="FontSize" Value="{StaticResource K.Size.H3}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="K.Body2" TargetType="TextBlock" BasedOn="{StaticResource K.Text}">
        <Setter Property="Foreground" Value="{StaticResource K.Text2Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="K.Caption" TargetType="TextBlock" BasedOn="{StaticResource K.Text}">
        <Setter Property="FontSize" Value="{StaticResource K.Size.Caption}" />
        <Setter Property="Foreground" Value="{StaticResource K.Text3Brush}" />
    </Style>
    <Style x:Key="K.Overline" TargetType="TextBlock" BasedOn="{StaticResource K.Text}">
        <Setter Property="FontSize" Value="{StaticResource K.Size.Micro}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource K.Text3Brush}" />
    </Style>
    <Style x:Key="K.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource K.Icons}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource K.Text1Brush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- ============================== surfaces ============================== -->
    <Style x:Key="K.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource K.Bg2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource K.LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource K.Radius.L}" />
        <Setter Property="Padding" Value="20" />
    </Style>
    <Style x:Key="K.Chip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource K.Bg3Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource K.LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource K.Radius.Pill}" />
        <Setter Property="Padding" Value="10,5" />
    </Style>

    <!-- ============================== buttons ============================== -->
    <Style x:Key="K.Button" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource K.Text1Brush}" />
        <Setter Property="Background" Value="{StaticResource K.Bg3Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource K.LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource K.Font}" />
        <Setter Property="FontSize" Value="{StaticResource K.Size.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Scale" />
                        </Grid.RenderTransform>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource K.Radius.S}" />
                        <Border x:Name="Hover" Background="White" Opacity="0" CornerRadius="{StaticResource K.Radius.S}" />
                        <Border x:Name="Focus" BorderBrush="{StaticResource K.Accent1Brush}" BorderThickness="2" Opacity="0" Margin="-3" CornerRadius="13" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.07" Duration="{StaticResource K.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource K.Base}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="{StaticResource K.Instant}" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="{StaticResource K.Instant}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource K.Slow}" EasingFunction="{StaticResource K.EaseSpring}" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource K.Slow}" EasingFunction="{StaticResource K.EaseSpring}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="K.Button.Primary" TargetType="Button" BasedOn="{StaticResource K.Button}">
        <Setter Property="Background" Value="{StaticResource K.AccentGradient}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.45" Color="{StaticResource K.AccentGlow}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="K.Button.Ghost" TargetType="Button" BasedOn="{StaticResource K.Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource K.Text2Brush}" />
    </Style>

    <Style x:Key="K.Button.Danger" TargetType="Button" BasedOn="{StaticResource K.Button}">
        <Setter Property="Background" Value="#26FF4D5E" />
        <Setter Property="BorderBrush" Value="#40FF4D5E" />
        <Setter Property="Foreground" Value="#FF7A87" />
    </Style>

    <Style x:Key="K.Button.Icon" TargetType="Button" BasedOn="{StaticResource K.Button}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource K.Icons}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="K.Button.IconGhost" TargetType="Button" BasedOn="{StaticResource K.Button.Icon}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource K.Text2Brush}" />
    </Style>

    <!-- window caption buttons -->
    <Style x:Key="K.Caption.Button" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Foreground" Value="{StaticResource K.Text2Brush}" />
        <Setter Property="FontFamily" Value="{StaticResource K.Icons}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource K.Text1Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="K.Caption.Close" TargetType="Button" BasedOn="{StaticResource K.Caption.Button}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E81123" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== toggle switch ============================== -->
    <Style x:Key="K.Toggle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource K.Text1Brush}" />
        <Setter Property="FontFamily" Value="{StaticResource K.Font}" />
        <Setter Property="FontSize" Value="{StaticResource K.Size.Body}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Grid Grid.Column="1" Width="44" Height="24" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="12" Background="{StaticResource K.Bg4Brush}" BorderBrush="{StaticResource K.Line2Brush}" BorderThickness="1" />
                            <Border x:Name="On" CornerRadius="12" Background="{StaticResource K.AccentGradientH}" Opacity="0" />
                            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="4,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobX" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.35" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobX" Storyboard.TargetProperty="X" To="20" Duration="{StaticResource K.Slow}" EasingFunction="{StaticResource K.EaseSpring}" />
                                        <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource K.Base}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobX" Storyboard.TargetProperty="X" To="0" Duration="{StaticResource K.Slow}" EasingFunction="{StaticResource K.EaseSpring}" />
                                        <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource K.Base}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- segmented choice (RadioButton) -->
    <Style x:Key="K.Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource K.Text2Brush}" />
        <Setter Property="FontFamily" Value="{StaticResource K.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Sel" CornerRadius="9" Background="{StaticResource K.Bg4Brush}" BorderBrush="{StaticResource K.Line2Brush}" BorderThickness="1" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource K.Text1Brush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource K.Base}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource K.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource K.Text1Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="K.SegmentHost" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource K.Bg1Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource K.LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- filter chip (ToggleButton-like RadioButton) -->
    <Style x:Key="K.FilterChip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource K.Text2Brush}" />
        <Setter Property="FontFamily" Value="{StaticResource K.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="999" Background="{StaticResource K.Bg2Brush}" BorderBrush="{StaticResource K.LineBrush}" BorderThickness="1" Padding="14,7">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource K.Bg3Brush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource K.Text1Brush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource K.Bg0Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== navigation rail item ============================== -->
    <Style x:Key="K.NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource K.Text3Brush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Height" Value="62" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Pill" Width="54" Height="54" CornerRadius="16" Background="{StaticResource K.Bg3Brush}" Opacity="0" />
                        <Border x:Name="Bar" Width="4" Height="22" CornerRadius="2" HorizontalAlignment="Left" Background="{StaticResource K.AccentGradient}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="BarScale" ScaleY="0.2" />
                            </Border.RenderTransform>
                        </Border>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" FontFamily="{StaticResource K.Icons}" FontSize="19" HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                            <ContentPresenter Margin="0,5,0,0" HorizontalAlignment="Center" TextElement.FontSize="10.5" TextElement.FontWeight="SemiBold" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource K.Text1Brush}" />
                            <Setter TargetName="Pill" Property="Opacity" Value="0.55" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource K.Text1Brush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource K.Base}" />
                                        <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource K.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="BarScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource K.Slow}" EasingFunction="{StaticResource K.EaseSpring}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource K.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource K.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="BarScale" Storyboard.TargetProperty="ScaleY" To="0.2" Duration="{StaticResource K.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== inputs ============================== -->
    <Style x:Key="K.TextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource K.Text1Brush}" />
        <Setter Property="Background" Value="{StaticResource K.Bg1Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource K.Line2Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource K.Accent1Brush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource K.Accent1Brush}" />
        <Setter Property="FontFamily" Value="{StaticResource K.Font}" />
        <Setter Property="FontSize" Value="{StaticResource K.Size.Body}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="40" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource K.Radius.S}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource K.Accent1Brush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="K.PasswordBox" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{StaticResource K.Text1Brush}" />
        <Setter Property="Background" Value="{StaticResource K.Bg1Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource K.Line2Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource K.Accent1Brush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="44" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource K.Radius.S}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource K.Accent1Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- slider -->
    <Style x:Key="K.SliderThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="18" Height="18" Background="Transparent">
                        <Ellipse x:Name="Ring" Fill="White" Width="16" Height="16">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.4" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="6" Height="6" Fill="{StaticResource K.Accent1Brush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Width" Value="18" />
                            <Setter TargetName="Ring" Property="Height" Value="18" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="K.SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" CornerRadius="2" Background="{StaticResource K.AccentGradientH}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="K.SliderRest" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" CornerRadius="2" Background="{StaticResource K.Bg4Brush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="K.Slider" TargetType="Slider">
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Track x:Name="PART_Track" VerticalAlignment="Center">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource K.SliderFill}" Command="Slider.DecreaseLarge" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource K.SliderRest}" Command="Slider.IncreaseLarge" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource K.SliderThumb}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- progress -->
    <Style x:Key="K.Progress" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="2" Background="{StaticResource K.Bg4Brush}" />
                        <Border x:Name="PART_Indicator" CornerRadius="2" Background="{StaticResource K.AccentGradientH}" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== combo box ============================== -->
    <Style x:Key="K.ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{StaticResource K.Bg1Brush}" BorderBrush="{StaticResource K.Line2Brush}" BorderThickness="1" CornerRadius="{StaticResource K.Radius.S}">
                        <TextBlock x:Name="Chev" Text="&#xE70D;" FontFamily="{StaticResource K.Icons}" FontSize="11" Foreground="{StaticResource K.Text2Brush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="ChevRot" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource K.Bg3Brush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource K.Accent1Brush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ChevRot" Storyboard.TargetProperty="Angle" To="180" Duration="{StaticResource K.Base}" EasingFunction="{StaticResource K.EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ChevRot" Storyboard.TargetProperty="Angle" To="0" Duration="{StaticResource K.Base}" EasingFunction="{StaticResource K.EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="K.ComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource K.Text1Brush}" />
        <Setter Property="FontFamily" Value="{StaticResource K.Font}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource K.ComboToggle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Margin="12,0,34,0" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" VerticalOffset="6">
                            <Border Background="{StaticResource K.Bg3Brush}" BorderBrush="{StaticResource K.Line2Brush}" BorderThickness="1" CornerRadius="12" Padding="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320" Margin="0,0,10,12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" />
                                </Border.Effect>
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{StaticResource K.Text1Brush}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bd" CornerRadius="8" Padding="10,8" Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource K.Bg4Brush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource K.AccentSoftBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== scrolling ============================== -->
    <Style x:Key="K.ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" CornerRadius="4" Background="#33FFFFFF" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#66FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,4">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource K.ScrollThumb}" Margin="1,0" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" Margin="4,0">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource K.ScrollThumb}" Margin="0,1" />
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================== menus & tooltips ============================== -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{StaticResource K.Text1Brush}" />
        <Setter Property="FontFamily" Value="{StaticResource K.Font}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource K.Bg3Brush}" BorderBrush="{StaticResource K.Line2Brush}" BorderThickness="1" CornerRadius="12" Padding="5" Margin="0,0,12,14">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.55" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource K.Text1Brush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" CornerRadius="8" Padding="10,8" Background="Transparent" MinWidth="200">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" TextElement.FontFamily="{StaticResource K.Icons}" TextElement.FontSize="14" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{StaticResource K.Text3Brush}" Margin="18,0,0,0" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource K.Bg4Brush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Separator" x:Key="{x:Static MenuItem.SeparatorStyleKey}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{StaticResource K.LineBrush}" Margin="8,4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource K.Text1Brush}" />
        <Setter Property="FontFamily" Value="{StaticResource K.Font}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource K.Bg4Brush}" BorderBrush="{StaticResource K.Line2Brush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,8,8">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
